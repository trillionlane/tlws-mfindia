# MFDataIndia — copy to .env and adjust. Never commit .env.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=mfdataindia
POSTGRES_USER=mfdata
# Use a real secret in any environment beyond local development.
POSTGRES_PASSWORD=***
POSTGRES_PORT=5432

# DSN used by the ingestion tools and the test suite.
# MF_TEST_DSN is read by tests/test_postgres_integration.py; without it the
# PostgreSQL integration tests are skipped and only the unit suite runs.
MFDATAINDIA_DSN=postgresql://mfdata:***@127.0.0.1:5432/mfdataindia
# MF_TEST_DSN=host=127.0.0.1 port=5432 dbname=mfdataindia user=mfdata password=***

# Set to 1 only for servers whose COPY sub-protocol is incomplete
# (e.g. some transaction poolers). Real PostgreSQL should use COPY.
# MF_TEST_NO_COPY=1

# --- Ingestion --------------------------------------------------------------
# api.mfapi.in is public but rate-sensitive: ~4,352 sequential NAV-history
# fetches. Keep the delay conservative and always send an identifying UA.
MFAPI_BASE_URL=https://api.mfapi.in
MFAPI_MIN_DELAY_SECONDS=1.0
MFAPI_MAX_RETRIES=5
MFAPI_USER_AGENT=MFDataIndia/0.1 (+contact: you@example.com)

# AMFI is geo-restricted from some networks; files are then supplied from an
# India server and recorded with acquisition='USER_PROVIDED'.
AMFI_BASE_URL=https://www.amfiindia.com
AMFI_NAVALL_PATH=/spages/NAVAll.txt

# Local directory for user-provided AMFI downloads.
AMFI_INBOX_DIR=./research/downloads

# --- Enrichment -------------------------------------------------------------
SCRIPBOX_BASE_URL=https://scripbox.com
SCRIPBOX_MIN_DELAY_SECONDS=2.0
