            "title": "Last Seen In Source"
          },
          "state": {
            "enum": [
              "active",
              "redeemed",
              "defunct",
              "unknown"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "evidence"
        ],
        "title": "FundLifecycle",
        "type": "object"
      },
      "FundMethodology": {
        "description": "How the NAV-derived numeric fields must be read. Only confirmed Growth\ncan be eligible; other options lack required distribution/unit-event truth.",
        "properties": {
          "basis": {
            "const": "nav_change",
            "title": "Basis",
            "type": "string"
          },
          "comparison_eligible": {
            "title": "Comparison Eligible",
            "type": "boolean"
          },
          "distribution_adjustment": {
            "enum": [
              "not_applicable",
              "unavailable"
            ],
            "title": "Distribution Adjustment",
            "type": "string"
          },
          "limitations": {
            "items": {
              "enum": [
                "distribution_history_unavailable",
                "lifecycle_not_active",
                "nav_freshness_lag",
                "nav_quality_signal",
                "nav_series_unavailable"
              ],
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          }
        },
        "required": [
          "basis",
          "distribution_adjustment",
          "comparison_eligible",
          "limitations"
        ],
        "title": "FundMethodology",
        "type": "object"
      },
      "FundNavFreshness": {
        "description": "Objective NAV freshness. The bands are server-owned (see\nqueries.FRESHNESS_*_DAYS); consumers must not redefine them.",
        "properties": {
          "dataset_as_of": {
            "anyOf": [
              {
                "format": "date",
