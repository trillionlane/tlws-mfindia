      "FundLifecycle": {
        "description": "Evidence-backed lifecycle. Absence or a stale NAV alone yields\n``unknown`` \u2014 there is deliberately no \"matured\" boolean in the contract.",
        "properties": {
          "evidence": {
            "enum": [
              "amfi_current_feed",
              "amfi_redeemed_marker",
              "amfi_defunct_marker",
              "not_seen_in_latest_feed",
              "insufficient_evidence"
            ],
            "title": "Evidence",
            "type": "string"
          },
          "last_seen_in_source": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
