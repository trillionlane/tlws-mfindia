  "info": {
    "title": "MFData Verified Fund Review",
    "version": "1.0.0",
    "x-contract-id": "mfdataindia-verified-review-v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/review/v1/funds": {
      "get": {
        "operationId": "list_queue_api_review_v1_funds_get",
        "parameters": [
          {
            "in": "query",
            "name": "after_code",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "After Code",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "pending_review",
                    "in_review",
                    "reviewed",
                    "needs_evidence"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "signal",
            "required": false,
