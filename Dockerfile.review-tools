FROM postgres:18.6-alpine

ARG VCS_REF
LABEL org.opencontainers.image.revision=$VCS_REF
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
RUN apk add --no-cache python3 py3-pip ca-certificates \
    && python3 -m venv /opt/review-tools \
    && /opt/review-tools/bin/pip install --no-cache-dir uv==0.11.3 \
    && addgroup -S -g 10001 mfreview \
    && adduser -S -D -H -u 10001 -G mfreview mfreview
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN /opt/review-tools/bin/uv sync --frozen --no-dev --no-editable --no-cache --python /opt/review-tools/bin/python
COPY scripts ./scripts
COPY sql ./sql
COPY contracts ./contracts
ENV PATH="/app/.venv/bin:${PATH}"
USER 10001:10001
ENTRYPOINT ["python", "/app/scripts/backup_verified_review_dev.py"]
