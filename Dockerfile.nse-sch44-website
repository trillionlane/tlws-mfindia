FROM mcr.microsoft.com/playwright/python:v1.64.1-noble
ARG VCS_REF
LABEL org.opencontainers.image.revision=$VCS_REF
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN pip install --no-cache-dir uv==0.11.3     && uv sync --frozen --no-dev --no-editable --no-cache     && uv pip install --python /app/.venv/bin/python --no-cache playwright==1.64.1
USER pwuser
ENTRYPOINT ["/app/.venv/bin/python", "-m", "mfdataindia.nse.sch44_website"]
